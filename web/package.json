{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && npm run build:app && npm run build:admin",
    "build:app": "VITE_BUILD_TARGET=app vite build",
    "build:admin": "VITE_BUILD_TARGET=admin vite build",
    "gen:api": "openapi-typescript ../docs/openapi.yaml -o src/types/openapi.generated.ts",
    "preview": "VITE_BUILD_TARGET=app vite preview --outDir dist/app",
    "preview:admin": "VITE_BUILD_TARGET=admin vite preview --outDir dist/admin",
    "test": "vitest run --config vitest.config.ts",
    "test:e2e": "playwright test tests/e2e/smoke.spec.ts --config playwright.config.ts",
    "test:e2e:all": "playwright test --config playwright.config.ts",
    "test:e2e:debug": "playwright test tests/debug --config playwright.config.ts",
    "lint": "eslint . --ext .vue,.ts,.tsx",
    "format": "prettier --write \"src/**/*.{vue,ts,tsx,css,scss}\""
  },
  "dependencies": {
    "@vueuse/core": "^10.0.0",
    "dayjs": "^1.11.0",
    "html2canvas": "^1.4.1",
    "pinia": "^2.1.0",
    "vue": "^3.5.25",
    "vue-router": "^4.5.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^24.10.1",
    "@typescript-eslint/eslint-plugin": "^7.7.0",
    "@typescript-eslint/parser": "^7.7.0",
    "@vitejs/plugin-vue": "^6.0.2",
    "@vue/test-utils": "^2.4.0",
    "@vue/tsconfig": "^0.8.1",
    "eslint": "^8.0.0",
    "eslint-plugin-vue": "^9.0.0",
    "openapi-typescript": "^7.5.1",
    "prettier": "^3.0.0",
    "puppeteer": "^24.39.1",
    "typescript": "~5.9.3",
    "vite": "^7.3.1",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.1.5"
  }
}
